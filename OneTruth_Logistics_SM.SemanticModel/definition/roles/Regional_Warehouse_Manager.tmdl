role Regional_Warehouse_Manager
	modelPermission: read

	tablePermission dimwarehouse =
			CONTAINS(
			    dimaccounts,
			    dimaccounts[region], dimwarehouse[region],
			    dimaccounts[Email], USERPRINCIPALNAME()
			)

	tablePermission dimaccounts

	annotation PBI_Id = 46457ff241524716a6b1f189289edac1

